NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/wedding_invitation
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional Cloudinary image hosting. Without these, uploads are stored locally in /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wedding-invitation
